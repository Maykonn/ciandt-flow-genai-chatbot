  "item": [
    {
      "name": "Basic Endpoints",
      "item": [
        {
          "name": "Root Endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Root endpoint that returns a welcome message"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains welcome message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"CI&T Flow API Integration Service\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check the health of the application, Flow API connection, and RAG documents path"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains health status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData.status).to.be.oneOf(['healthy', 'warning']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "description": "Basic endpoints for checking application status and health"
    },
    {
      "name": "RAG Operations",
      "item": [
        {
          "name": "Get Document Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rag/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "stats"]
            },
            "description": "Get statistics about the documents in the RAG folder"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains document stats\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('total_files');",
                  "    pm.expect(jsonData).to.have.property('supported_files');",
                  "    pm.expect(jsonData).to.have.property('unsupported_files');",
                  "    pm.expect(jsonData).to.have.property('extensions');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Process Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rag/process",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "process"]
            },
            "description": "Load and process documents from the RAG folder"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains processed documents\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('document_count');",
                  "    pm.expect(jsonData).to.have.property('documents').that.is.an('array');",
                  "    pm.expect(jsonData.documents.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Process Documents with Indexing",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rag/process?index_to_vector_store=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "process"],
              "query": [
                {
                  "key": "index_to_vector_store",
                  "value": "true",
                  "description": "Whether to index documents to the vector store"
                }
              ]
            },
            "description": "Load and process documents from the RAG folder and index them to the vector store"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains indexed documents\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('document_count');",
                  "    pm.expect(jsonData).to.have.property('documents').that.is.an('array');",
                  "    pm.expect(jsonData.documents.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Initialize Embeddings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rag/initialize-embeddings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "initialize-embeddings"]
            },
            "description": "Initialize the embedding model"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains embedding model initialization\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('model');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "description": "Operations related to RAG document processing and embeddings"
    },
    {
      "name": "Vector Store",
      "item": [
        {
          "name": "Get Vector Store Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rag/vector-store",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "vector-store"]
            },
            "description": "Get statistics about the vector store"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains vector store stats\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('document_count');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Query Vector Store",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rag/query",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "query"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"What is artificial intelligence?\",\n    \"top_k\": 3\n}"
            },
            "description": "Query the vector store for relevant documents"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains relevant documents\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('results').that.is.an('array');",
                  "    pm.expect(jsonData.results.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reindex Documents",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/rag/reindex?force=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "reindex"],
              "query": [
                {
                  "key": "force",
                  "value": "false",
                  "description": "Whether to force reindexing by clearing the vector store first"
                }
              ]
            },
            "description": "Reindex all documents in the RAG folder"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains reindexing confirmation\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Clear Vector Store",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/rag/vector-store",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rag", "vector-store"]
            },
            "description": "Clear all documents from the vector store"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response confirms vector store clearance\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData.message).to.eql(\"Vector store cleared successfully\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "description": "Operations related to the vector store for document embeddings"
    },
