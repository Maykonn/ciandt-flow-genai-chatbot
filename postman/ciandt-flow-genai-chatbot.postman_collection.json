{
  "info": {
    "_postman_id": "b8f3e8a0-5c1d-4f3e-8d5c-1d4f3e8d5c1d",
    "name": "ciandt-flow-genai-chatbot",
    "description": "Collection for testing the CI&T Flow GenAI Chatbot backend integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root Endpoint",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Root endpoint that returns a welcome message"
      },
      "response": []
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Check the health of the application, Flow API connection, and RAG documents path"
      },
      "response": []
    },
    {
      "name": "Generate Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "generate"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"prompt\": \"What is artificial intelligence?\",\n    \"max_tokens\": 3000,\n    \"model\": \"gpt-4o\",\n    \"stream\": false\n}"
        },
        "description": "Generate text using the Flow API's OpenAI Chat Completions endpoint"
      },
      "response": []
    },
    {
      "name": "RAG - Get Document Stats",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/rag/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "stats"]
        },
        "description": "Get statistics about the documents in the RAG folder"
      },
      "response": []
    },
    {
      "name": "RAG - Process Documents",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/rag/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "process"]
        },
        "description": "Load and process documents from the RAG folder"
      },
      "response": []
    },
    {
      "name": "RAG - Initialize Embeddings",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/rag/initialize-embeddings",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "initialize-embeddings"]
        },
        "description": "Initialize the embedding model"
      },
      "response": []
    },
    {
      "name": "Vector Store - Get Stats",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/rag/vector-store",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "vector-store"]
        },
        "description": "Get statistics about the vector store"
      },
      "response": []
    },
    {
      "name": "Vector Store - Clear",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/rag/vector-store",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "vector-store"]
        },
        "description": "Clear all documents from the vector store"
      },
      "response": []
    },
    {
      "name": "Vector Store - Query",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rag/query",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "query"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"query\": \"What is artificial intelligence?\",\n    \"top_k\": 3\n}"
        },
        "description": "Query the vector store for relevant documents"
      },
      "response": []
    },
    {
      "name": "RAG - Reindex Documents",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/rag/reindex?force=false",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "reindex"],
          "query": [
            {
              "key": "force",
              "value": "false",
              "description": "Whether to force reindexing by clearing the vector store first"
            }
          ]
        },
        "description": "Reindex all documents in the RAG folder"
      },
      "response": []
    },
    {
      "name": "RAG - Process Documents with Indexing",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/rag/process?index_to_vector_store=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rag", "process"],
          "query": [
            {
              "key": "index_to_vector_store",
              "value": "true",
              "description": "Whether to index documents to the vector store"
            }
          ]
        },
        "description": "Load and process documents from the RAG folder and index them to the vector store"
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ]
}
